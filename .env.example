# Copiar a .env y completar los valores reales para cada entorno.
DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Configuración MySQL (opcional; si no se define, el proyecto usa SQLite para local/CI)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_NAME=horisoft_db
MYSQL_USER=horisoft_app
MYSQL_PASSWORD=replace-with-a-long-random-password

# Credenciales dedicadas de Docker Compose (no usar root como usuario Django).
DOCKER_DB_USER=horisoft_app
DOCKER_DB_PASSWORD=replace-with-a-long-random-password
DOCKER_DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
