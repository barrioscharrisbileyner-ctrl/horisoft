<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/horisoft_fondo"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/reservas_titulo"
        style="@style/TituloPantalla" />

    <ProgressBar
        android:id="@+id/progresoReservas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEstadoReservas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/horisoft_texto_suave"
        android:visibility="gone"
        tools:text="Tu residencia aún no tiene reservas." />

    <Button
        android:id="@+id/btnReintentarReservas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/boton_reintentar"
        android:visibility="gone"
        style="@style/BotonHorisoft" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contenedorReservas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
