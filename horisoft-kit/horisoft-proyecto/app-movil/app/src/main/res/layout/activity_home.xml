<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/horisoft_fondo"
    android:padding="32dp">

    <TextView
        android:id="@+id/tvBienvenida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TituloHorisoft"
        tools:text="Bienvenido, Juan Pérez" />

    <TextView
        android:id="@+id/tvRol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        android:textColor="@color/horisoft_texto"
        tools:text="Rol: Residente" />

    <Button
        android:id="@+id/btnZonasComunes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_boton_zonas"
        style="@style/BotonHorisoft" />

    <Button
        android:id="@+id/btnMisReservas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/home_boton_mis_reservas"
        style="@style/BotonHorisoft" />

    <Button
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/home_boton_cerrar_sesion"
        style="@style/BotonHorisoftSecundario" />

</LinearLayout>
