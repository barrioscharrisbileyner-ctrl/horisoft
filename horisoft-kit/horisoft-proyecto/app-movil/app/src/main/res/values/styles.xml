<resources>

    <!-- Tema base de la app -->
    <style name="Theme.Horisoft" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/horisoft_azul_oscuro</item>
        <item name="colorPrimaryDark">@color/horisoft_azul_oscuro</item>
        <item name="colorAccent">@color/horisoft_azul</item>
        <item name="android:windowBackground">@color/horisoft_fondo</item>
    </style>

    <!-- Botón principal -->
    <style name="BotonHorisoft">
        <item name="android:background">@color/horisoft_azul</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Botón secundario (acciones menos destacadas: cerrar sesión, cancelar) -->
    <style name="BotonHorisoftSecundario" parent="BotonHorisoft">
        <item name="android:background">@color/horisoft_azul_oscuro</item>
    </style>

    <style name="TituloHorisoft">
        <item name="android:textColor">@color/horisoft_azul_oscuro</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Título de pantallas internas -->
    <style name="TituloPantalla" parent="TituloHorisoft">
        <item name="android:textSize">24sp</item>
    </style>

</resources>
